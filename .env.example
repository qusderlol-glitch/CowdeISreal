# Публичные значения проекта Supabase (Project Settings -> API). Их видит браузер — это нормально.
# НИКОГДА не кладите сюда service_role ключ.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Только STUN (бесплатно, без ретрансляции). Формат: JSON-массив RTCIceServer.
# TURN-учётки сюда не кладите: их выдаёт Edge Function turn-credentials (см. README).
VITE_STUN_SERVERS=["stun:stun.l.google.com:19302"]

# Включить запрос краткоживущих TURN-учёток у Edge Function turn-credentials (true/false).
VITE_TURN_ENABLED=false

# Провайдер звонков: mesh (по умолчанию, до 6 участников) или sfu (нужна Edge Function sfu-token + клиент провайдера).
VITE_CALL_PROVIDER=mesh
